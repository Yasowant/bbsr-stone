# Public site URL — used for canonical tags, sitemap and OpenGraph
NEXT_PUBLIC_SITE_URL=https://bbsrstone.com

# Optional: quote-request emails via Resend (https://resend.com)
# If these are unset the API route still validates and logs submissions.
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@bbsrstone.com
QUOTE_FROM_EMAIL=website@bbsrstone.com
